<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categories — Product Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  {{> navbar}}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
      <a href="/dashboard" class="hover:text-gray-700">Home</a><span>/</span><span class="text-gray-900 font-medium">Categories</span>
    </nav>
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Categories</h1>
      <a href="/categories/create" class="inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>Add Category</a>
    </div>
    <form method="GET" action="/categories" class="mb-6">
      <div class="flex gap-3">
        <input type="text" name="search" value="{{search}}" class="block w-full max-w-xs rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" placeholder="Search categories...">
        <button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">Search</button>
      </div>
    </form>
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Slug</th><th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th></tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          {{#each categories}}
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 text-sm font-medium text-gray-900">{{this.name}}</td>
            <td class="px-6 py-4 text-sm text-gray-500">{{this.slug}}</td>
            <td class="px-6 py-4 text-right">
              <a href="/categories/{{this.id}}/edit" class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-500 mr-3">Edit</a>
              <button onclick="confirmDelete({{this.id}})" class="inline-flex items-center gap-1 text-sm font-medium text-red-600 hover:text-red-500">Delete</button>
            </td>
          </tr>
          {{else}}
          <tr><td colspan="3" class="px-6 py-12 text-center text-sm text-gray-500">No categories found.</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  <script>
  function confirmDelete(id) { if (confirm('Are you sure you want to delete this category?')) { var f = document.createElement('form'); f.method = 'POST'; f.action = '/categories/' + id + '/delete'; var i = document.createElement('input'); i.type = 'hidden'; i.name = '_method'; i.value = 'DELETE'; f.appendChild(i); document.body.appendChild(f); f.submit(); } }
  </script>
</body>
</html>
