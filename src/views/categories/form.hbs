<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if category}}Edit{{else}}Create{{/if}} Category — Product Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  {{> navbar}}
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
      <a href="/dashboard" class="hover:text-gray-700">Home</a><span>/</span><a href="/categories" class="hover:text-gray-700">Categories</a><span>/</span><span class="text-gray-900 font-medium">{{#if category}}Edit{{else}}Create{{/if}}</span>
    </nav>
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h1 class="text-xl font-bold text-gray-900 mb-6">{{#if category}}Edit Category{{else}}Create Category{{/if}}</h1>
      {{#if error}}<div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">{{error}}</div>{{/if}}
      <form method="POST" action="{{#if category}}/categories/{{category.id}}/update{{else}}/categories/store{{/if}}" class="space-y-5">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-900 mb-1.5">Name</label>
          <input type="text" name="name" id="name" value="{{category.name}}" required class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" placeholder="Category name">
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">{{#if category}}Update{{else}}Save{{/if}}</button>
          <a href="/categories" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
