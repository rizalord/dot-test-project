<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if product}}Edit{{else}}Create{{/if}} Product — Product Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  {{> navbar}}
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
      <a href="/dashboard" class="hover:text-gray-700">Home</a><span>/</span><a href="/products" class="hover:text-gray-700">Products</a><span>/</span><span class="text-gray-900 font-medium">{{#if product}}Edit{{else}}Create{{/if}}</span>
    </nav>
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h1 class="text-xl font-bold text-gray-900 mb-6">{{#if product}}Edit Product{{else}}Create Product{{/if}}</h1>
      {{#if error}}<div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">{{error}}</div>{{/if}}
      <form method="POST" action="{{#if product}}/products/{{product.id}}/update{{else}}/products/store{{/if}}" class="space-y-5">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-900 mb-1.5">Name</label>
          <input type="text" name="name" id="name" value="{{product.name}}" required class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" placeholder="Product name">
        </div>
        <div>
          <label for="categoryId" class="block text-sm font-medium text-gray-900 mb-1.5">Category</label>
          <select name="categoryId" id="categoryId" required class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
            <option value="">Select category</option>
            {{#each categories}}
            <option value="{{this.id}}" {{#if (eq ../product.categoryId this.id)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>
        <div>
          <label for="price" class="block text-sm font-medium text-gray-900 mb-1.5">Price</label>
          <input type="number" name="price" id="price" value="{{product.price}}" required min="0" class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" placeholder="0">
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">{{#if product}}Update{{else}}Save{{/if}}</button>
          <a href="/products" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
