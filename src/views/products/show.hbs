<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{product.name}} — Product Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <header class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-3">
          <span class="text-lg font-bold text-gray-900">ProductMS</span>
        </div>
        <div class="flex items-center gap-4">
          <span class="text-sm text-gray-600">{{user.name}}</span>
          <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center">
            <span class="text-xs font-medium text-white">{{user.initials}}</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
      <a href="/dashboard" class="hover:text-gray-700">Home</a>
      <span>/</span>
      <a href="/products" class="hover:text-gray-700">Products</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">{{product.name}}</span>
    </nav>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">{{product.name}}</h1>
        <div class="flex items-center gap-2">
          <a href="/products/{{product.id}}/edit"
            class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
            Edit
          </a>
        </div>
      </div>

      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-500">Name</dt>
          <dd class="mt-1 text-sm text-gray-900">{{product.name}}</dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Slug</dt>
          <dd class="mt-1 text-sm text-gray-900">{{product.slug}}</dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Category</dt>
          <dd class="mt-1 text-sm text-gray-900">{{categoryName}}</dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Price</dt>
          <dd class="mt-1 text-sm text-gray-900">Rp {{formatPrice product.price}}</dd>
        </div>
      </dl>
    </div>

    <div class="mt-6">
      <a href="/products" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">&larr; Back to Products</a>
    </div>
  </div>
</body>
</html>
