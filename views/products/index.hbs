<!DOCTYPE html>
<html lang="en">

<head>
    {{> head}}
</head>

<body>
    {{> navbar}}

    <main>
        <div class="max-w-7xl mx-auto">
            {{!-- Header --}}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
                <h1 style="font-size:1.5rem;font-weight:700;color:#1f2937">Products</h1>
                <a href="/products/create" class="mt-3 sm:mt-0 inline-block bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-700 transition text-center">
                    + Create Product
                </a>
            </div>

            {{!-- Search --}}
            <form method="GET" action="/products" class="mb-6">
                <div class="flex gap-2">
                    <input type="text" name="search" value="{{search}}" placeholder="Search products..."
                        class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" />
                    <button type="submit" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-200 transition font-medium">
                        Search
                    </button>
                </div>
            </form>

            {{!-- Table --}}
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="w-full">
                    <thead>
                        <tr class="bg-gray-50 text-left text-sm font-medium text-gray-500 uppercase tracking-wider">
                            <th class="px-6 py-3">Name</th>
                            <th class="px-6 py-3">Price</th>
                            <th class="px-6 py-3">Categories</th>
                            <th class="px-6 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        {{#each products}}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 text-sm font-medium text-gray-900">{{this.name}}</td>
                            <td class="px-6 py-4 text-sm text-gray-700">{{formatPrice this.price}}</td>
                            <td class="px-6 py-4 text-sm text-gray-700">
                                {{#each this.categories}}
                                <span class="inline-block bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded mr-1">{{this.name}}</span>
                                {{else}}
                                <span class="text-gray-400">—</span>
                                {{/each}}
                            </td>
                            <td class="px-6 py-4 text-sm text-right whitespace-nowrap">
                                <a href="/products/{{this.id}}/edit" class="text-indigo-600 hover:text-indigo-800 font-medium mr-3">Edit</a>
                                <form action="/products/{{this.id}}/delete" method="POST" class="inline" onsubmit="return confirm('Delete this product?')">
                                    <button type="submit" class="text-red-600 hover:text-red-800 font-medium">Delete</button>
                                </form>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                                {{#if search}}No products found matching "{{search}}".{{else}}No products yet. <a href="/products/create" class="text-indigo-600">Create your first product</a>{{/if}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            {{!-- Pagination --}}
            {{#if meta}}
            {{#if (gt meta.total_pages 1)}}
            <div class="flex items-center justify-between mt-6">
                <p class="text-sm text-gray-500">
                    Page {{meta.page}} of {{meta.total_pages}} ({{meta.total}} total)
                </p>
                <div class="flex gap-2">
                    {{#if (gt meta.page 1)}}
                    <a href="/products?page={{subtract meta.page 1}}{{#if search}}&search={{search}}{{/if}}" class="px-3 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50">Previous</a>
                    {{/if}}
                    {{#if (lt meta.page meta.total_pages)}}
                    <a href="/products?page={{add meta.page 1}}{{#if search}}&search={{search}}{{/if}}" class="px-3 py-1.5 bg-white border border-gray-300 rounded text-sm hover:bg-gray-50">Next</a>
                    {{/if}}
                </div>
            </div>
            {{/if}}
            {{/if}}
        </div>
    </main>

    {{> footer}}
</body>

</html>
