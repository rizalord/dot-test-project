<!DOCTYPE html>
<html lang="en">

<head>
    {{> head}}
</head>

<body>
    {{> navbar}}

    <main>
        <div class="max-w-2xl mx-auto">
            <h1 style="font-size:1.5rem;font-weight:700;color:#1f2937;margin-bottom:1.5rem">{{#if isEdit}}Edit Product{{else}}Create Product{{/if}}</h1>

            <div class="bg-white rounded-lg shadow p-6">
                {{#if error}}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm">{{error}}</div>
                {{/if}}

                <form action="{{#if isEdit}}/products/{{product.id}}/edit{{else}}/products/create{{/if}}" method="POST" class="space-y-5">
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                        <input type="text" id="name" name="name" value="{{product.name}}" required maxlength="200" placeholder="e.g. Nike Air Max"
                            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" />
                        <p class="text-xs text-gray-400 mt-1">Product name displayed in catalog</p>
                    </div>

                    <div>
                        <label for="price" class="block text-sm font-medium text-gray-700 mb-1">Price (Rp)</label>
                        <input type="number" id="price" name="price" value="{{product.price}}" required min="0" step="1" placeholder="e.g. 250000"
                            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" />
                        <p class="text-xs text-gray-400 mt-1">Price in Indonesian Rupiah, e.g. 250000 for Rp 250.000</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Categories</label>
                        <div class="space-y-2 max-h-48 overflow-y-auto border border-gray-200 rounded-lg p-3">
                            {{#each categories}}
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" name="category_ids" value="{{this.id}}"
                                    {{#if (includes ../selectedCategoryIds this.id)}}checked{{/if}}
                                    class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                                <span class="text-sm text-gray-700">{{this.name}}</span>
                            </label>
                            {{else}}
                            <p class="text-sm text-gray-400">No categories available. <a href="/categories/create" class="text-indigo-600 hover:text-indigo-800">Create one</a></p>
                            {{/each}}
                        </div>
                        <p class="text-xs text-gray-400 mt-1">Select one or more categories for this product</p>
                    </div>

                    <div class="flex items-center gap-3 pt-2">
                        <button type="submit" class="bg-indigo-600 text-white px-6 py-2.5 rounded-lg font-medium hover:bg-indigo-700 transition">
                            {{#if isEdit}}Update{{else}}Create{{/if}}
                        </button>
                        <a href="/products" class="text-gray-500 hover:text-gray-700 font-medium">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    {{> footer}}
</body>

</html>
