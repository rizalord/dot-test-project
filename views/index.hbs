<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel — PT DOT Indonesia</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
  <header class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">D</span>
          </div>
          <span class="font-semibold text-gray-900">Admin Panel</span>
        </div>
        <nav class="flex items-center gap-4">
          <a href="/login" class="text-sm text-gray-600 hover:text-gray-900">Login</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="flex-1">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl">
          Product Management
        </h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
          Simple and intuitive product management system.
        </p>
      </div>
    </div>
  </main>

  <footer class="border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <p class="text-center text-sm text-gray-500">
        &copy; {{year}} PT DOT Indonesia
      </p>
    </div>
  </footer>
</body>
</html>
